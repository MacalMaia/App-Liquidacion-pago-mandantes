# Copiar este archivo como .env y completar los valores

# Clave de API de Anthropic (obligatoria)
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXX

# ── SSO Microsoft (Entra ID) ────────────────────────────────────────────────
# El SSO se activa solo si MS_CLIENT_ID, MS_TENANT_ID y MS_CLIENT_SECRET están
# definidos. Ver backend/app/auth/sso_microsoft.py
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=https://TU-DOMINIO/auth/callback

# Clave aleatoria para firmar la cookie de sesión (openssl rand -hex 32)
SESSION_SECRET=

# Orígenes permitidos por CORS (coma-separados). En producción: https://TU-DOMINIO
ALLOWED_ORIGINS=*
